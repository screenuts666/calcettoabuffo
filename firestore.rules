rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Configurazione e chiavi di runtime: leggibile dall'app, scrittura solo ad admin autenticati
    match /_config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Parametri motore storicizzati per stagione (Super-Lock Admin)
    match /config_stagioni/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Collezioni dell'applicazione calcetto
    match /giocatori/{document=**} {
      allow read, write: if true;
    }
    match /partite/{document=**} {
      allow read, write: if true;
    }
    match /stagioni/{document=**} {
      allow read, write: if true;
    }
    match /voti/{document=**} {
      allow read, write: if true;
    }
    match /skill/{document=**} {
      allow read, write: if true;
    }
    match /confronti/{document=**} {
      allow read, write: if true;
    }
    match /tts_cache/{document=**} {
      allow read, write: if true;
    }
  }
}
