# Configurazione Bot Telegram Hotfix Agent (@CalcettoHotfixBot)
# Copia questo file in .env e compila le variabili mancanti.

# Token del bot fornito da @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Il tuo Chat ID Telegram (avvia il bot e digita /myid per ottenerlo al primo avvio)
TELEGRAM_ALLOWED_CHAT_ID=

# API Key di Google Gemini (ottienila gratuitamente su https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Modello Gemini ufficiale e livello di reasoning/thinking
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=HIGH

# Repository GitHub di riferimento (Owner/Repo)
GITHUB_REPO=screenuts666/calcettoabuffo

# Progetti Firebase (definiti in .firebaserc)
FIREBASE_PROJECT_DEV=calcettoabuffone
FIREBASE_PROJECT_PROD=calcettoabuffone-prod

# URL pubblici degli ambienti
URL_DEV=https://calcettoabuffone.web.app
URL_PROD=https://calcettoabuffone-prod.web.app

# Orario del reminder mattutino (formato HH:MM, default 08:30 Europe/Rome)
MORNING_CHECK_TIME=08:30
